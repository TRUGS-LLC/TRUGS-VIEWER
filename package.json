{
  "name": "trugs-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical read-only 3D viewer for TRUG graphs — pure-browser, load → orbit/zoom → click-to-inspect.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "e2e": "playwright test",
    "fixture:gen": "node scripts/gen-fixture.mjs",
    "license:check": "node scripts/license-check.mjs",
    "license:gen": "node scripts/gen-licenses.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "postprocessing": "^6.39.1",
    "r3f-forcegraph": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
